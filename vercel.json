{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://secure.przelewy24.pl https://sandbox.przelewy24.pl https://*.supabase.co wss://*.supabase.co https://*.i.posthog.com https://*.sentry.io; frame-src https://secure.przelewy24.pl https://sandbox.przelewy24.pl; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/:path*.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "functions": {
    "app/api/bot/**/*": { "memory": 3008 },
    "app/api/cron/**/*": { "memory": 3008 },
    "app/api/orakul/**/*": { "memory": 3008 }
  },
  "crons": [
    {
      "path": "/api/cron/orakul-abandoned",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/deadlines",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily-ops",
      "schedule": "0 7 * * *"
    }
  ]
}
